<Window
    x:Class="TestWindowCapture.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:l="http://schemas.livet-mvvm.net/2011/wpf"
    xmlns:v="clr-namespace:TestWindowCapture.Views"
    xmlns:vm="clr-namespace:TestWindowCapture.ViewModels"
    Title="MainWindow"
    Width="525"
    Height="350">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <behaviors:Interaction.Triggers>
        <!--  When ContentRendered event raised, Initialize method of ViewModel would be called.  -->
        <behaviors:EventTrigger EventName="ContentRendered">
            <l:LivetCallMethodAction
                MethodName="Initialize"
                MethodTarget="{Binding}" />
        </behaviors:EventTrigger>

        <!--  Dispose method is called, when Window closing.  -->
        <behaviors:EventTrigger EventName="Closed">
            <l:DataContextDisposeAction />
        </behaviors:EventTrigger>

        <!--  If you make user choose 'OK or Cancel' closing Window, then please use Window Close cancel Behavior.  -->

    </behaviors:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Button
                x:Name="StartButton"
                Command="{Binding StartCommand}"
                Content="Start"
                IsEnabled="{Binding StartCommand.CanExecute}" />
            <Button
                x:Name="CaptureButton"
                Command="{Binding CaptureCommand}"
                Content="Capture"
                IsEnabled="{Binding CaptureCommand.CanExecute}" />
            <Button
                x:Name="StopButton"
                Command="{Binding StopCommand}"
                Content="Stop"
                IsEnabled="{Binding StopCommand.CanExecute}" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Image
                x:Name="CaptureImage"
                Source="{Binding CapturedBitMap, Mode=OneWay}"
                Stretch="None" />
        </ScrollViewer>
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding FrameCount}" />
        </StatusBar>
    </Grid>
</Window>
